---
import Base from '../../layouts/Base.astro';
---
<Base title="Registration received" description="Thanks for registering." noindex>
  <section class="page-head">
    <div class="wrap">
      <h1>Thank you, you're registered</h1>
      <p>We've emailed you a confirmation. A member of the club will be in touch before your first class.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <h2>Before your first class</h2>
      <p>Read <a href="/first-class">what to expect at your first class</a>: what to wear, when to arrive and dojo etiquette.</p>
      <p>Classes are Monday and Wednesday, 6:00 to 7:00 pm.</p>
    </div>
  </section>
</Base>
