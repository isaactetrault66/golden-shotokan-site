---
import Base from '../layouts/Base.astro';
import Schedule from '../components/Schedule.astro';
import JoinCallout from '../components/JoinCallout.astro';
import EventsList from '../components/EventsList.astro';
import Prices from '../components/Prices.astro';
import { Picture } from 'astro:assets';
import teamPhoto from '../assets/team.jpg';
import logoImg from '../assets/logo.png';
import { SITE, PRICING, AGE_GUIDE, DOJO_KUN } from '../config.js';

const explore = [
  ['/shotokan#lineage', 'Our lineage', 'From Gichin Funakoshi to the ISKF and our club in Golden.'],
  ['/shotokan#ranks', 'Belt ranks', 'The grades from white belt to black belt, and the kata for each.'],
  ['/shotokan#kata', 'The kata', 'The 26 Shotokan kata and what their names mean.'],
  ['/shotokan#dojo-kun', 'The dojo kun', 'The five principles we recite at the end of every class.'],
  ['/instructors', 'Our instructors', 'Meet Sensei Tyler Tetrault, 4th degree black belt.'],
  ['/events', 'Events', 'Gradings, seminars, tournaments and club events.'],
];
---
<Base
  title="Shotokan Karate Classes in Golden, BC | Golden Shotokan Karate Society"
  description="Traditional ISKF Shotokan karate in Golden, BC for teens and adults, ages 13+. Classes Monday and Wednesday evenings, plus Friday open training. Affordable and beginner friendly."
>
  <section class="hero hero-video">
    <video class="hero-bg" autoplay muted loop playsinline preload="metadata" poster="/video/hero-poster.jpg" aria-hidden="true">
      <source src="/video/hero.webm" type="video/webm" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-tint" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div>
      <h1>Shotokan Karate in Golden, BC</h1>
      <p class="lead">Traditional ISKF karate for teens and adults. Build confidence, fitness and self-defence skills in one of the most affordable activities in Golden. Beginners welcome, no experience needed.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/inquire">Ask about joining</a>
        <a class="btn btn-ghost" href="/classes">See classes</a>
      </div>
      <ul class="hero-facts">
        <li><strong>Mon and Wed</strong> classes 6:00 to 7:30 pm</li>
        <li><strong>Fri</strong> open training 6:00 to 7:30 pm</li>
        <li><strong>Ages 13+</strong> teens and adults</li>
        <li><strong>ISKF</strong> member club</li>
      </ul>
      </div>
      <Picture class="hero-logo" src={logoImg} formats={['avif', 'webp']} widths={[300, 600]} sizes="300px" alt="Golden Shotokan Karate Society logo: a red and navy yin-yang mandala" loading="eager" fetchpriority="high" />
    </div>
    <button type="button" class="motion-toggle" aria-pressed="false" data-motion-toggle>
      <svg viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" /><rect x="7" y="1" width="3" height="10" /></svg>
      <span>Pause motion</span>
    </button>
  </section>

  <section class="kun-strip" aria-label="The dojo kun">
    <div class="kun-track">
      {[0, 1].map((copy) => (
        <ul aria-hidden={copy ? 'true' : undefined}>
          {DOJO_KUN.map((k) => <li><strong>{k.en}</strong><span lang="ja">一、{k.ja}</span></li>)}
        </ul>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Karate for teens and adults in Golden</h2>
      <p class="prose">Teens and adults, including parents and their teenagers, train together on the same nights. Everyone follows the same belt path, and instructors adjust each drill to the student.</p>
      <div class="grid">
        {AGE_GUIDE.map((a) => (
          <div class="card">
            <h3>{a.group} <span class="muted">({a.ages})</span></h3>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:20px"><a class="link-more" href="/classes">See classes and pricing</a></p>
    </div>
  </section>

  <section class="video-band" aria-labelledby="rei-heading">
    <video class="band-bg" muted loop playsinline preload="none" poster="/video/bow-poster.jpg" aria-hidden="true" data-lazy-video>
      <source data-src="/video/bow.webm" type="video/webm" />
      <source data-src="/video/bow.mp4" type="video/mp4" />
    </video>
    <div class="band-tint" aria-hidden="true"></div>
    <div class="wrap band-inner">
      <p class="band-kicker"><span lang="ja">礼</span> Rei, the bow</p>
      <h2 id="rei-heading">Karate begins and ends with respect</h2>
      <p>Every class at our dojo opens and closes with a bow. It's the first of Gichin Funakoshi's twenty precepts, and it's how our students greet each other, their instructors and the training floor.</p>
    </div>
  </section>
  <script>
    // Load and play the band video only when it scrolls near the screen.
    const v = document.querySelector('[data-lazy-video]') as HTMLVideoElement | null;
    if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting || document.body.classList.contains('motion-paused')) { v.pause(); continue; }
          if (!v.dataset.loaded) {
            v.querySelectorAll('source').forEach((s) => (s.src = s.dataset.src!));
            v.load();
            v.dataset.loaded = '1';
          }
          v.play().catch(() => {});
        }
      }, { rootMargin: '200px' });
      io.observe(v);
    }

    // Pause button for the hero video, the bowing video and the dojo kun ticker.
    const toggle = document.querySelector('[data-motion-toggle]') as HTMLButtonElement | null;
    toggle?.addEventListener('click', () => {
      const paused = document.body.classList.toggle('motion-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.querySelector('span')!.textContent = paused ? 'Play motion' : 'Pause motion';
      toggle.querySelector('svg')!.innerHTML = paused
        ? '<path d="M2 1 L11 6 L2 11 Z" />'
        : '<rect x="2" y="1" width="3" height="10" /><rect x="7" y="1" width="3" height="10" />';
      document.querySelectorAll('video[autoplay], [data-lazy-video]').forEach((el) => {
        const vid = el as HTMLVideoElement;
        if (paused) vid.pause();
        else if (vid === v ? v.dataset.loaded : true) vid.play().catch(() => {});
      });
    });
  </script>

  <section class="section section-alt">
    <div class="wrap two-col">
      <div>
        <h2>Class times</h2>
        <Schedule />
      </div>
      <div>
        <h2>Simple, affordable pricing</h2>
        <p>{PRICING.note} Your uniform and insurance are included.</p>
        <Prices />
        <a class="btn btn-primary" href="/inquire">Ask about joining</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <Picture class="rounded" src={teamPhoto} formats={['avif', 'webp']} widths={[480, 800, 1350]} sizes="(max-width: 800px) 100vw, 534px" alt="Golden Shotokan Karate Society karate students and instructors with their medals at the dojo in Golden, BC" />
      <div>
        <h2>Why train with us</h2>
        <ul>
          <li><strong>Traditional Shotokan.</strong> We teach the karate of the {SITE.affiliation}, with ISKF ranks and gradings.</li>
          <li><strong>A community club.</strong> A local Golden dojo where students and families get to know each other.</li>
          <li><strong>Beginner friendly.</strong> No martial arts experience or fitness level needed to start.</li>
          <li><strong>Affordable.</strong> One fee per term covers your uniform, insurance and training.</li>
        </ul>
        <a class="link-more" href="/about">About our club</a>
      </div>
    </div>
  </section>

  <section class="section section-alt explore">
    <div class="wrap">
      <h2>Explore the dojo</h2>
      <div class="grid">
        {explore.map(([href, title, text]) => (
          <a class="card" href={href}><h3>{title}</h3><p>{text}</p></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" data-events-section hidden>
    <div class="wrap">
      <EventsList limit={3} showEmpty={false} heading="Coming up" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Find us in Golden</h2>
      <p>{SITE.street}, {SITE.city}, {SITE.region} {SITE.postalCode}</p>
      <p>Enter by the {SITE.entrance.charAt(0).toLowerCase() + SITE.entrance.slice(1)}.</p>
      <p><a class="link-more" href="/contact">Directions, parking and contact details</a></p>
    </div>
  </section>

  <JoinCallout />
</Base>
