---
import Base from '../layouts/Base.astro';
import Schedule from '../components/Schedule.astro';
import JoinCallout from '../components/JoinCallout.astro';
import EventsList from '../components/EventsList.astro';
import Prices from '../components/Prices.astro';
import { SITE, PRICING, AGE_GUIDE, DOJO_KUN } from '../config.js';

const explore = [
  ['/shotokan#lineage', 'Our lineage', 'From Gichin Funakoshi to the ISKF and our club in Golden.'],
  ['/shotokan#ranks', 'Belt ranks', 'The grades from white belt to black belt, and the kata for each.'],
  ['/shotokan#kata', 'The kata', 'The 26 Shotokan kata and what their names mean.'],
  ['/shotokan#dojo-kun', 'The dojo kun', 'The five principles we recite at the end of every class.'],
  ['/instructors', 'Our instructors', 'Meet Sensei Tyler Tetrault, 4th degree black belt.'],
  ['/events', 'Events', 'Gradings, seminars, tournaments and club events.'],
];
---
<Base
  title="Shotokan Karate Classes in Golden, BC | Golden Shotokan Karate Society"
  description="Traditional ISKF Shotokan karate in Golden, BC for teens and adults, ages 13+. Classes Monday and Wednesday evenings, plus Friday open training. Affordable and beginner friendly."
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div>
      <p class="eyebrow">Golden, British Columbia</p>
      <h1>Shotokan Karate in Golden, BC</h1>
      <p class="lead">Traditional ISKF karate for teens and adults. Build confidence, fitness and self-defence skills in one of the most affordable activities in Golden. Beginners welcome, no experience needed.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/inquire">Ask about joining</a>
        <a class="btn btn-ghost" href="/classes">See classes</a>
      </div>
      <ul class="hero-facts">
        <li><strong>Mon and Wed</strong> classes 6:00 to 7:00 pm</li>
        <li><strong>Fri</strong> open training 6:00 to 7:00 pm</li>
        <li><strong>Ages 13+</strong> teens and adults</li>
        <li><strong>ISKF</strong> member club</li>
      </ul>
      </div>
      <img class="hero-logo" src="/images/logo.png" alt="Golden Shotokan Karate Society logo: a red and navy yin-yang mandala" width="512" height="512" />
    </div>
  </section>

  <section class="kun-strip" aria-label="The dojo kun">
    <div class="kun-track">
      {[0, 1].map((copy) => (
        <ul aria-hidden={copy ? 'true' : undefined}>
          {DOJO_KUN.map((k) => <li><strong>{k.en}</strong><span lang="ja">一、{k.ja}</span></li>)}
        </ul>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Karate for teens and adults in Golden</h2>
      <p class="prose">Teens and adults, including parents and their teenagers, train together on the same nights. Everyone follows the same belt path, and instructors adjust each drill to the student.</p>
      <div class="grid">
        {AGE_GUIDE.map((a) => (
          <div class="card">
            <h3>{a.group} <span class="muted">({a.ages})</span></h3>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:20px"><a href="/classes">See classes and pricing →</a></p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap two-col">
      <div>
        <h2>Class times</h2>
        <Schedule />
      </div>
      <div>
        <h2>Simple, affordable pricing</h2>
        <p>{PRICING.note} Your uniform and insurance are included.</p>
        <Prices />
        <a class="btn btn-primary" href="/inquire">Ask about joining</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <img src="/images/team.jpg" alt="Golden Shotokan Karate Society karate students and instructors with their medals at the dojo in Golden, BC" width="1350" height="734" loading="lazy" style="border-radius:10px" />
      <div>
        <h2>Why train with us</h2>
        <ul>
          <li><strong>Traditional Shotokan.</strong> We teach the karate of the {SITE.affiliation}, with ISKF ranks and gradings.</li>
          <li><strong>A community club.</strong> A local Golden dojo where students and families get to know each other.</li>
          <li><strong>Beginner friendly.</strong> No martial arts experience or fitness level needed to start.</li>
          <li><strong>Affordable.</strong> One fee per term covers your uniform, insurance and training.</li>
        </ul>
        <a href="/about">About our club →</a>
      </div>
    </div>
  </section>

  <section class="section section-alt explore">
    <div class="wrap">
      <h2>Explore the dojo</h2>
      <div class="grid">
        {explore.map(([href, title, text]) => (
          <a class="card" href={href}><h3>{title} →</h3><p>{text}</p></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" data-events-section hidden>
    <div class="wrap">
      <EventsList limit={3} showEmpty={false} heading="Coming up" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Find us in Golden</h2>
      <p>{SITE.street}, {SITE.city}, {SITE.region} {SITE.postalCode}</p>
      <p>Enter by the {SITE.entrance.charAt(0).toLowerCase() + SITE.entrance.slice(1)}.</p>
      <p><a href="/contact">Directions, parking and contact details →</a></p>
    </div>
  </section>

  <JoinCallout />
</Base>
