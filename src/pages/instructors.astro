---
import Base from '../layouts/Base.astro';
import JoinCallout from '../components/JoinCallout.astro';

// TODO: bio and photo for each instructor.
const instructors = [
  { name: 'Sensei Tyler Tetrault', role: 'Head Instructor', rank: '4th degree black belt (Yondan), ISKF', bio: 'Sensei Tyler leads every Monday and Wednesday class. A longer bio is coming soon.' },
];
---
<Base
  title="Karate Instructors in Golden, BC"
  description="Meet Sensei Tyler Tetrault, 4th degree black belt and head instructor of ISKF Shotokan karate classes in Golden, BC."
>
  <section class="page-head">
    <div class="wrap">
      <h1>Our instructors</h1>
      <p>Learn traditional Shotokan karate in Golden from an experienced ISKF black belt.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap grid">
      {instructors.map((i) => (
        <article class="card">
          <div class="photo-placeholder" style="margin-bottom:16px">Photo of {i.name}</div>
          <h2 style="font-size:1.4rem">{i.name}</h2>
          <p class="muted">{i.role} · {i.rank}</p>
          <p>{i.bio}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section section-alt">
    <div class="wrap prose">
      <h2>Safe for teens</h2>
      <p>Instructors who teach students under 18 hold current criminal record checks and first aid certification. Parents are always welcome to watch class.</p>
    </div>
  </section>
  <JoinCallout />
</Base>
