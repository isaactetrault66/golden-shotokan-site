---
import Base from '../layouts/Base.astro';
import JoinCallout from '../components/JoinCallout.astro';
import { PRICING } from '../config.js';

const faqs = [
  ['Do I need any experience?', 'No. Most people start karate as complete beginners. Instructors teach every technique from the ground up.'],
  ['How old do you have to be?', 'Students start at age 13. Teens and adults train together in the same classes, and there is no upper age limit.'],
  ['How much does it cost?', `Fees are per term (${PRICING.term}): ${PRICING.rates.filter((r) => r.price.startsWith('$')).map((r) => `${r.group} ${r.price}`).join(', ')}. ${PRICING.note}`],
  ['What does the fee include?', `${PRICING.includes}. There is nothing extra to buy to get started.`],
  ['When are classes?', 'Monday and Wednesday, 6:00 to 7:00 pm. See the classes page for any holiday closures.'],
  ['How often should I train?', 'Coming to both weekly classes gives the fastest progress, but once a week is fine to start.'],
  ['What should I wear to my first class?', 'Comfortable athletic clothes for your first class. We train barefoot. Your karate uniform (gi) is included in your fee.'],
  ['Is karate safe for teens?', 'Yes. Partner work is controlled, matched by size and level, and closely supervised. Parents are welcome to watch.'],
  ['Can adults start at 40 or older?', 'Absolutely. Many adults start later in life and train at their own pace.'],
  ['How is Shotokan different from other styles?', 'Shotokan emphasises strong stances, long-range linear techniques and kata. It is one of the most widely practised traditional styles in the world.'],
  ['Can parents and teens train together?', 'Yes. Teens and adults share the same classes, so parents can train alongside their teenagers.'],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base
  title="Karate FAQ: Golden, BC"
  description="Answers to common questions about Shotokan karate classes in Golden, BC: cost, ages, what to wear, safety and more."
  schema={[faqSchema]}
>
  <section class="page-head">
    <div class="wrap">
      <h1>Frequently asked questions</h1>
      <p>Everything new students and parents ask us about karate in Golden.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      {faqs.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
  <JoinCallout />
</Base>
