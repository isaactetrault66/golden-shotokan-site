---
import Base from '../layouts/Base.astro';
import { TURNSTILE_SITE_KEY, SITE } from '../config.js';
---
<Base
  title="Ask About Karate Classes in Golden, BC"
  description="Send Golden Shotokan Karate Society a question about joining Shotokan karate in Golden, BC. Teens and adults 13+. Classes Monday and Wednesday, 6:00 to 7:00 pm."
>
  <section class="page-head">
    <div class="wrap">
      <h1>Get in touch</h1>
      <p>Interested in joining, or have a question? Send us a message and a member of the club will get back to you. We don't take registrations or payments online.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap" style="max-width:760px">
      <form class="stack" id="inquiry-form" method="post" action="/api/inquire" novalidate>
        <p class="required-note">Fields marked * are required.</p>
        <div class="row-2">
          <label>Your name *<input name="name" required autocomplete="name" maxlength="120" /></label>
          <label>Interested in
            <select name="interest">
              <option value="">Choose one</option>
              <option value="Teens">Teens (13 to 17)</option>
              <option value="Adults">Adults (18+)</option>
              <option value="Family">A parent and teen together</option>
              <option value="Open training">Friday open training</option>
              <option value="Not sure yet">Not sure yet</option>
            </select>
          </label>
        </div>
        <div class="row-2">
          <label>Email *<input type="email" name="email" required autocomplete="email" maxlength="200" /></label>
          <label>Phone (optional)<input type="tel" name="phone" autocomplete="tel" maxlength="40" /></label>
        </div>
        <label>Your message *<span class="hint">For example: who would be training, their age and any experience, and any questions</span>
          <textarea name="message" rows="5" required maxlength="2000"></textarea>
        </label>
        <label>How did you hear about us?
          <select name="referral">
            <option value="">Choose one</option>
            <option>Google search</option>
            <option>Google Maps</option>
            <option>Friend or family</option>
            <option>Facebook or Instagram</option>
            <option>School or community event</option>
            <option>Poster or flyer</option>
            <option>Other</option>
          </select>
        </label>
        <p class="muted" style="margin:0">We use your details only to reply to you. See our <a href="/privacy">privacy policy</a>.</p>

        <div class="hp" aria-hidden="true">
          <label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>}

        <div class="form-msg" id="form-msg" role="alert"></div>
        <div><button class="btn btn-primary" type="submit" id="submit-btn">Send message</button></div>
        <p class="muted">Prefer to call or email? <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`}>{SITE.phone}</a> or <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      </form>
    </div>
  </section>
  {TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    const form = document.getElementById('inquiry-form') as HTMLFormElement;
    const msg = document.getElementById('form-msg')!;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.className = 'form-msg';
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/inquire', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
        window.location.href = '/inquire/thanks';
      } catch (err) {
        msg.textContent = (err as Error).message;
        msg.className = 'form-msg error';
        btn.disabled = false;
        btn.textContent = 'Send message';
      }
    });
  </script>
</Base>
