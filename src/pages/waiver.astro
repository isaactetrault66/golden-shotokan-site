---
import Base from '../layouts/Base.astro';
import { SITE } from '../config.js';
---
<Base title="Liability Waiver" description={`Liability waiver for ${SITE.name}.`} noindex>
  <section class="page-head"><div class="wrap"><h1>Liability waiver</h1><p>Placeholder. The club must replace this with its own waiver (often supplied by the ISKF or the club's insurer) before launch.</p></div></section>
  <section class="section">
    <div class="wrap prose">
      <p>Karate is a physical activity that involves contact and a risk of injury. By registering, the participant (or their parent or guardian if under 18) acknowledges these risks, confirms the participant is fit to take part, and agrees to follow instructors' directions and dojo rules.</p>
      <p><strong>Final waiver text to be provided by the club.</strong></p>
    </div>
  </section>
</Base>
