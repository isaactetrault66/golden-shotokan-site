---
// Admin back end. Protected by Cloudflare Access (see README); the data comes
// from /api/admin/*, which re-checks the Access login on every request.
import '../styles/global.css';
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Admin | Golden Shotokan</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    body { background: #f4f1ec; }
    .bar { background: var(--ink); color: #fff; }
    .bar .wrap { display: flex; justify-content: space-between; align-items: center; min-height: 56px; gap: 12px; flex-wrap: wrap; }
    .bar a { color: #fff; }
    .tabs { display: flex; gap: 8px; margin: 20px 0; }
    .tabs button { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; font: inherit; cursor: pointer; }
    .tabs button[aria-selected="true"] { background: var(--ink); color: #fff; border-color: var(--ink); }
    .counts { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
    .count { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 8px 14px; cursor: pointer; font: inherit; text-align: left; }
    .count b { display: block; font-size: 1.4rem; }
    .count[aria-pressed="true"] { border-color: var(--red); outline: 1px solid var(--red); }
    .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
    .filters input, .filters select { width: auto; flex: 1 1 180px; }
    .table-wrap { overflow-x: auto; background: #fff; border: 1px solid var(--line); border-radius: 10px; }
    table.list { width: 100%; border-collapse: collapse; font-size: .95rem; }
    table.list th, table.list td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
    table.list tbody tr { cursor: pointer; }
    table.list tbody tr:hover { background: #faf6f0; }
    .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: .8rem; font-weight: 600; background: #eee; }
    .pill[data-s="New"] { background: #fde2df; color: #8c1d17; }
    .pill[data-s="Contacted"] { background: #fff1d6; color: #7a5200; }
    .pill[data-s="First class done"] { background: #e2eefc; color: #1d4b8c; }
    .pill[data-s="Enrolled"] { background: #dff3e4; color: #1d6b35; }
    .pill[data-s="Not continuing"] { background: #eee; color: #555; }
    dialog { border: 0; border-radius: 12px; padding: 0; width: min(720px, 94vw); max-height: 90vh; }
    dialog::backdrop { background: rgba(0,0,0,.4); }
    .dlg-head { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: #fff; }
    .dlg-body { padding: 20px; }
    .dlg-body dl { display: grid; grid-template-columns: 180px 1fr; gap: 6px 16px; margin: 0 0 20px; }
    .dlg-body dt { color: var(--muted); }
    .dlg-body dd { margin: 0; white-space: pre-wrap; }
    @media (max-width: 600px) { .dlg-body dl { grid-template-columns: 1fr; } .dlg-body dd { margin-bottom: 8px; } }
    .actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 12px; }
    .btn-small { padding: .45em 1em; font-size: .9rem; }
    .btn-danger { background: none; border: 1px solid #c9a29e; color: #8c1d17; }
    .sched-row { display: grid; grid-template-columns: 1.2fr 1fr 1fr 2fr auto; gap: 8px; margin-bottom: 8px; }
    @media (max-width: 700px) { .sched-row { grid-template-columns: 1fr 1fr; } }
    .toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 10px 18px; border-radius: 8px; display: none; }
    .empty { padding: 40px; text-align: center; color: var(--muted); }
  </style>
</head>
<body>
  <div class="bar"><div class="wrap"><strong>Golden Shotokan admin</strong><span><span id="who"></span> · <a href="/">View site</a> · <a href="/cdn-cgi/access/logout">Sign out</a></span></div></div>
  <main class="wrap" style="padding-bottom:60px">
    <div class="tabs" role="tablist">
      <button role="tab" aria-selected="true" data-tab="regs">Registrations</button>
      <button role="tab" aria-selected="false" data-tab="sched">Class schedule</button>
    </div>
    <div class="form-msg" id="err" role="alert"></div>

    <section id="tab-regs">
      <div class="counts" id="counts"></div>
      <div class="filters">
        <input type="search" id="q" placeholder="Search name, email or phone" />
        <select id="program"><option value="">All groups</option><option>Kids</option><option>Teens</option><option>Adults</option><option>Family</option></select>
        <a class="btn btn-primary btn-small" href="/api/admin/export">Export CSV</a>
      </div>
      <div class="table-wrap">
        <table class="list">
          <thead><tr><th>Received</th><th>Student</th><th>Age</th><th>Group</th><th>Contact</th><th>Status</th></tr></thead>
          <tbody id="rows"></tbody>
        </table>
        <div class="empty" id="empty" hidden>No registrations yet.</div>
      </div>
    </section>

    <section id="tab-sched" hidden>
      <div class="card">
        <h2>Class schedule</h2>
        <p class="muted">Changes show on the website within about 5 minutes.</p>
        <div id="sched-rows"></div>
        <p><button class="btn btn-ghost btn-small" id="add-class" type="button">+ Add class</button></p>
        <label>Notice shown under the schedule <span class="hint">e.g. "No class Monday, Oct 13 (Thanksgiving)". Leave empty for none.</span>
          <input id="notice" maxlength="300" />
        </label>
        <div class="actions"><button class="btn btn-primary" id="save-sched" type="button">Save schedule</button></div>
      </div>
    </section>
  </main>

  <dialog id="dlg">
    <div class="dlg-head"><strong id="dlg-title"></strong><button class="btn btn-ghost btn-small" id="dlg-close" type="button">Close</button></div>
    <div class="dlg-body">
      <dl id="dlg-fields"></dl>
      <label>Status <select id="dlg-status"></select></label>
      <label style="margin-top:12px">Notes <textarea id="dlg-notes" rows="4"></textarea></label>
      <div class="actions">
        <button class="btn btn-primary btn-small" id="dlg-save" type="button">Save</button>
        <button class="btn btn-danger btn-small" id="dlg-delete" type="button">Delete registration</button>
      </div>
    </div>
  </dialog>
  <div class="toast" id="toast"></div>

  <script>
    import { STATUSES, DAYS, ageOn } from '../../lib/registration.js';

    const $ = (id) => document.getElementById(id)!;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[ch]);
    let regs: any[] = [];
    let statusFilter = '';
    let current: any = null;

    const toast = (t: string) => { const el = $('toast'); el.textContent = t; el.style.display = 'block'; setTimeout(() => (el.style.display = 'none'), 2200); };
    const showErr = (t: string) => { const el = $('err'); el.textContent = t; el.className = t ? 'form-msg error' : 'form-msg'; };

    async function api(path: string, opts: RequestInit = {}) {
      const res = await fetch(path, { ...opts, headers: { 'Content-Type': 'application/json', ...(opts.headers || {}) } });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) throw new Error('You are not signed in. Reload the page to sign in.');
      if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
      return data;
    }

    function renderCounts(counts: Record<string, number>) {
      const total = Object.values(counts).reduce((a, b) => a + b, 0);
      const items = [['', 'All', total], ...STATUSES.map((s) => [s, s, counts[s] || 0])];
      $('counts').innerHTML = items
        .map(([v, label, n]) => `<button class="count" data-status="${esc(v)}" aria-pressed="${v === statusFilter}"><b>${n}</b>${esc(label)}</button>`)
        .join('');
      $('counts').querySelectorAll('button').forEach((b) =>
        b.addEventListener('click', () => { statusFilter = (b as HTMLElement).dataset.status || ''; load(); })
      );
    }

    function renderRows() {
      $('empty').hidden = regs.length > 0;
      $('rows').innerHTML = regs
        .map((r) => {
          const when = new Date(r.created_at).toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric' });
          return `<tr data-id="${r.id}" id="reg-${r.id}"><td>${esc(when)}</td><td><strong>${esc(r.student_first)} ${esc(r.student_last)}</strong></td><td>${esc(ageOn(r.dob))}</td><td>${esc(r.program)}</td><td>${esc(r.email)}<br><span class="muted">${esc(r.phone)}</span></td><td><span class="pill" data-s="${esc(r.status)}">${esc(r.status)}</span></td></tr>`;
        })
        .join('');
      $('rows').querySelectorAll('tr').forEach((tr) => tr.addEventListener('click', () => open(Number((tr as HTMLElement).dataset.id))));
    }

    let timer: number | undefined;
    async function load() {
      const p = new URLSearchParams();
      if (statusFilter) p.set('status', statusFilter);
      const prog = ($('program') as HTMLSelectElement).value;
      if (prog) p.set('program', prog);
      const q = ($('q') as HTMLInputElement).value.trim();
      if (q) p.set('q', q);
      try {
        const data = await api(`/api/admin/registrations?${p}`);
        regs = data.registrations;
        renderCounts(data.counts);
        renderRows();
        showErr('');
        const m = location.hash.match(/^#reg-(\d+)$/);
        if (m && !current) open(Number(m[1]));
      } catch (e) { showErr((e as Error).message); }
    }

    const FIELDS: [string, (r: any) => unknown][] = [
      ['Received', (r) => new Date(r.created_at).toLocaleString('en-CA')],
      ['Date of birth', (r) => `${r.dob} (age ${ageOn(r.dob)})`],
      ['Group', (r) => r.program], ['Experience', (r) => r.experience], ['Family members', (r) => r.family_members],
      ['Parent or guardian', (r) => r.guardian_name], ['Email', (r) => r.email], ['Phone', (r) => r.phone], ['Town', (r) => r.city],
      ['Preferred start', (r) => r.start_date], ['Preferred class', (r) => r.preferred_class], ['Heard about us', (r) => r.referral],
      ['Medical notes', (r) => r.medical], ['Emergency contact', (r) => `${r.emergency_name}, ${r.emergency_phone}`],
      ['Waiver accepted', (r) => (r.waiver ? 'Yes' : 'No')], ['Photo consent', (r) => (r.photo_consent ? 'Yes' : 'No')],
      ['Emails', (r) => r.email_status],
    ];

    function open(id: number) {
      current = regs.find((r) => r.id === id);
      if (!current) return;
      $('dlg-title').textContent = `${current.student_first} ${current.student_last}`;
      $('dlg-fields').innerHTML = FIELDS.map(([k, f]) => [k, f(current)]).filter(([, v]) => v).map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join('');
      $('dlg-status').innerHTML = STATUSES.map((s) => `<option ${s === current.status ? 'selected' : ''}>${esc(s)}</option>`).join('');
      ($('dlg-notes') as HTMLTextAreaElement).value = current.notes || '';
      history.replaceState(null, '', `#reg-${id}`);
      ($('dlg') as HTMLDialogElement).showModal();
    }
    function close() { ($('dlg') as HTMLDialogElement).close(); }
    $('dlg').addEventListener('close', () => { current = null; history.replaceState(null, '', location.pathname); });
    $('dlg-close').addEventListener('click', close);
    $('dlg-save').addEventListener('click', async () => {
      try {
        await api(`/api/admin/registrations/${current.id}`, { method: 'PATCH', body: JSON.stringify({ status: ($('dlg-status') as HTMLSelectElement).value, notes: ($('dlg-notes') as HTMLTextAreaElement).value }) });
        close(); toast('Saved'); load();
      } catch (e) { showErr((e as Error).message); }
    });
    $('dlg-delete').addEventListener('click', async () => {
      const btn = $('dlg-delete');
      if (btn.dataset.confirm !== 'yes') { btn.dataset.confirm = 'yes'; btn.textContent = 'Click again to delete permanently'; return; }
      try {
        await api(`/api/admin/registrations/${current.id}`, { method: 'DELETE' });
        btn.dataset.confirm = ''; btn.textContent = 'Delete registration';
        close(); toast('Deleted'); load();
      } catch (e) { showErr((e as Error).message); }
    });

    $('q').addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(load, 250); });
    $('program').addEventListener('change', load);

    // Tabs
    document.querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      const tab = (b as HTMLElement).dataset.tab;
      $('tab-regs').hidden = tab !== 'regs';
      $('tab-sched').hidden = tab !== 'sched';
      if (tab === 'sched') loadSchedule();
    }));

    // Schedule editor
    function schedRow(c: any = { day: 'Monday', start: '18:00', end: '19:30', name: 'Karate class, all ages' }) {
      const div = document.createElement('div');
      div.className = 'sched-row';
      div.innerHTML = `<select data-k="day">${DAYS.map((d) => `<option ${d === c.day ? 'selected' : ''}>${d}</option>`).join('')}</select>
        <input type="time" data-k="start" value="${esc(c.start)}" aria-label="Start time" />
        <input type="time" data-k="end" value="${esc(c.end)}" aria-label="End time" />
        <input data-k="name" value="${esc(c.name)}" maxlength="80" aria-label="Class name" />
        <button class="btn btn-danger btn-small" type="button">Remove</button>`;
      div.querySelector('button')!.addEventListener('click', () => div.remove());
      $('sched-rows').appendChild(div);
    }
    async function loadSchedule() {
      try {
        const res = await fetch('/api/schedule', { cache: 'no-store' });
        const data = await res.json();
        $('sched-rows').innerHTML = '';
        data.classes.forEach(schedRow);
        ($('notice') as HTMLInputElement).value = data.notice || '';
      } catch (e) { showErr('Could not load the schedule.'); }
    }
    $('add-class').addEventListener('click', () => schedRow());
    $('save-sched').addEventListener('click', async () => {
      const classes = [...$('sched-rows').querySelectorAll('.sched-row')].map((row) =>
        Object.fromEntries([...row.querySelectorAll('[data-k]')].map((el) => [(el as HTMLElement).dataset.k, (el as HTMLInputElement).value]))
      );
      try {
        await api('/api/admin/schedule', { method: 'PUT', body: JSON.stringify({ classes, notice: ($('notice') as HTMLInputElement).value }) });
        toast('Schedule saved'); showErr('');
      } catch (e) { showErr((e as Error).message); }
    });

    api('/api/admin/me').then((d) => ($('who').textContent = d.email)).catch(() => {});
    load();
  </script>
</body>
</html>
