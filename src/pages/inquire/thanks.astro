---
import Base from '../../layouts/Base.astro';
---
<Base title="Message sent" description="Thanks for your message." noindex>
  <section class="page-head">
    <div class="wrap">
      <h1>Thanks, your message is on its way</h1>
      <p>We've emailed you a copy. A member of the club will reply soon.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <p>Classes are Monday and Wednesday, 6:00 to 7:00 pm. Open training is Friday, 6:00 to 7:00 pm.</p>
      <p><a href="/classes">See classes and pricing →</a></p>
    </div>
  </section>
</Base>
