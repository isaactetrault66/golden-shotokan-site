---
// Renders the default schedule into the HTML (so Google can read it), then
// swaps in the live schedule from the admin area when the page loads.
import { DEFAULT_SCHEDULE, fmtRange } from '../config.js';
---
<table class="schedule" data-live-schedule>
  <thead><tr><th>Day</th><th>Time</th><th>Class</th></tr></thead>
  <tbody>
    {DEFAULT_SCHEDULE.map((c) => (
      <tr><td>{c.day}</td><td>{fmtRange(c.start, c.end)}</td><td>{c.name}</td></tr>
    ))}
  </tbody>
</table>
<p class="muted schedule-note" data-schedule-note></p>
<script>
  import { fmtRange } from '../config.js';
  const esc = (s) => String(s).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);
  fetch('/api/schedule')
    .then((r) => (r.ok ? r.json() : null))
    .then((data) => {
      if (!data) return;
      if (data.classes?.length) {
        const rows = data.classes
          .map((c) => `<tr><td>${esc(c.day)}</td><td>${esc(fmtRange(c.start, c.end))}</td><td>${esc(c.name)}</td></tr>`)
          .join('');
        document.querySelectorAll('[data-live-schedule] tbody').forEach((tb) => (tb.innerHTML = rows));
      }
      if (data.notice) document.querySelectorAll('[data-schedule-note]').forEach((n) => (n.textContent = data.notice));
    })
    .catch(() => {});
</script>
