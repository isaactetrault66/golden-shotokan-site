---
// Featured ISKF event. Details from worldshotocup.mx and iskf.com (checked 2026-10-15).
// Hides itself in the browser once the event is over.
const ENDS = '2026-10-26';
const site = 'https://worldshotocup.mx/';
const schedule = [
  { day: 'Wednesday, October 21', items: [['9:00 am to 5:00 pm', 'Check-in and registration, Hampton Inn by Hilton lobby']] },
  { day: 'Thursday, October 22', items: [
    ['9:30 am', 'Seminar with Shihan Okazaki (brown and black belts), Dojo Central ISKF Mérida'],
    ['11:00 am', 'Judges course and exams'],
    ['6:00 pm', 'Beginner and intermediate seminar (up to 4th kyu)'],
  ] },
  { day: 'Friday, October 23', items: [
    ['9:30 am', 'Seminar with Shihan Okazaki (brown and black belts)'],
    ['11:00 am', 'Dan examinations'],
    ['3:30 pm', 'Green and purple belt tournament'],
  ] },
  { day: 'Saturday, October 24', items: [
    ['8:00 am', 'Opening ceremony'],
    ['9:00 am', 'Senior and brown belt tournaments'],
  ] },
  { day: 'Sunday, October 25', items: [
    ['8:30 am', 'Black belt tournaments (17 and under, and 18 to 44)'],
    ['8:00 pm', 'Closing banquet and Sayonara party'],
  ] },
];
const fees = [
  ['One event (kata or kumite)', '$40'],
  ['Kata and kumite', '$60'],
  ['Team kata or team kumite', '$80'],
  ['Shihan Okazaki seminar', '$40 for one class, $60 for two'],
  ['Judges course', 'Free (exam $80)'],
  ['Closing banquet', '$80 per person'],
  ['Spectators', '$2 per day, under 15 free'],
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: '5th ISKF World Shoto Cup',
  startDate: '2026-10-22',
  endDate: '2026-10-25',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: 'Centro de Convenciones Yucatán Siglo XXI',
    address: { '@type': 'PostalAddress', streetAddress: 'Calle 60 Norte 299, Zona Industrial', addressLocality: 'Mérida', addressRegion: 'Yucatán', addressCountry: 'MX' },
  },
  organizer: { '@type': 'Organization', name: 'ISKF México', url: site },
  url: site,
};
---
<article class="feature-event" data-ends={ENDS}>
  <div class="feature-head">
    <p class="event-kind">ISKF World Championship</p>
    <h2>5th ISKF World Shoto Cup</h2>
    <p class="feature-meta"><strong>October 22 to 25, 2026</strong> · Mérida, Yucatán, Mexico</p>
    <p>Shotokan karateka from ISKF clubs around the world meet in Mérida for four days of seminars, dan examinations and the world tournament in kata and kumite. The event is led by ISKF Chief Instructor Shihan Hiroyoshi Okazaki and hosted by ISKF México.</p>
    <p class="feature-links">
      <a class="btn btn-primary" href={site} target="_blank" rel="noopener">Official event site</a>
      <a class="btn btn-ghost" href="https://www.iskf.com/events.html" target="_blank" rel="noopener">Forms and brochure (ISKF)</a>
    </p>
  </div>

  <div class="feature-grid">
    <section>
      <h3>Schedule</h3>
      <dl class="feature-schedule">
        {schedule.map((d) => (
          <>
            <dt>{d.day}</dt>
            {d.items.map(([t, what]) => <dd><span>{t}</span> {what}</dd>)}
          </>
        ))}
      </dl>
      <p class="muted small">Times are local to Mérida, which is on the same clock as Golden in October. Check the official site for changes.</p>
    </section>

    <div>
      <section>
        <h3>Where</h3>
        <p><strong>Tournament:</strong> Centro de Convenciones Yucatán Siglo XXI, Calle 60 Norte #299, Zona Industrial, Mérida</p>
        <p><strong>Seminars and judges course:</strong> Dojo Central ISKF Mérida, Calle 4 #141A x 4 Diagonal, Fracc. Montecristo</p>
        <p><strong>Getting there:</strong> Fly into Mérida (MID), about a $25 USD taxi to the hotel area. From Cancún (CUN), ADO buses take about 3 hours 15 minutes. The organizers list partner hotels with group rates on the event site.</p>
      </section>
      <section>
        <h3>Fees (USD)</h3>
        <table class="feature-fees">
          <tbody>
            {fees.map(([what, cost]) => <tr><th scope="row">{what}</th><td>{cost}</td></tr>)}
          </tbody>
        </table>
      </section>
    </div>
  </div>

  <section class="feature-foot">
    <h3>Divisions and entries</h3>
    <p>More than 100 individual and team divisions in kata and kumite, from age 7 to 55+ and from green belt to black belt. Competitors enter through their national ISKF organization. The published entry deadline was August 31, 2026, and dan and judge exam sign-up closed August 10, so talk to Sensei Tyler if you are thinking of going.</p>
    <p class="muted small">Organizer contact: worldshotocup2026@hotmail.com · WhatsApp +52 999 324 5527</p>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</article>
<script>
  document.querySelectorAll<HTMLElement>('.feature-event[data-ends]').forEach((el) => {
    if (new Date() >= new Date(el.dataset.ends + 'T12:00:00Z')) el.remove();
  });
</script>
